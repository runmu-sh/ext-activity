{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client.Activity.Batch",
  "type": "object",
  "required": [
    "stream_id",
    "last_seq",
    "events"
  ],
  "properties": {
    "stream_id": {
      "type": "string"
    },
    "last_seq": {
      "type": "number"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "seq",
        "kind"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "seq": {
          "type": "number"
        },
        "ts_ms": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "actor": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/$defs/ref"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "npc_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "location": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/$defs/ref"
        },
        "meta": {
          "type": "object",
          "properties": {
            "group_name": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
